# Verba configuration – copy to `.env` in the repository root and adjust.
# Contains placeholders only. Never commit a real `.env` file.

# ---- Storage & limits -------------------------------------------------------
# Where uploads, transcripts (SQLite) and temp files are kept. Default: backend/data
# VERBA_DATA_DIR=/absolute/path/to/verba-data
VERBA_MAX_UPLOAD_MB=500
VERBA_MAX_STORAGE_MB=10000
VERBA_MAX_MEDIA_DURATION_MIN=240
VERBA_MAX_CONCURRENT_JOBS=1
VERBA_MAX_JOB_ATTEMPTS=2

# ---- Transcription engines --------------------------------------------------
# Comma-separated list of engines that may be used. "mock" is the clearly labelled test engine.
VERBA_ALLOWED_PROVIDERS=faster-whisper,openai-whisper,mock
# "auto" picks the best installed local engine and never falls back to the mock or a cloud API.
VERBA_DEFAULT_PROVIDER=auto

# Local Whisper (see docs/WHISPER_SETUP.md). Models: tiny, base, small, medium, large-v3
VERBA_WHISPER_MODEL=base
# Folder that holds downloaded model weights (optional).
# VERBA_WHISPER_MODEL_DIR=/absolute/path/to/models
VERBA_WHISPER_DEVICE=cpu
VERBA_WHISPER_COMPUTE_TYPE=int8
# Keep false: model weights are only used if already present. true lets the engine download them itself.
VERBA_ALLOW_MODEL_DOWNLOAD=false

# ---- External (cloud) providers – OFF by default ---------------------------
# No external adapter is implemented yet. Even when enabled, Verba fails closed and sends nothing.
VERBA_EXTERNAL_PROVIDERS_ENABLED=false
VERBA_EXTERNAL_API_KEY=replace-me-only-after-owner-approval

# ---- Network ---------------------------------------------------------------
VERBA_HOST=127.0.0.1
VERBA_PORT=8000
VERBA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
VERBA_LOG_LEVEL=INFO

# ---- Frontend (put this one in frontend/.env.local) -------------------------
# Browser-visible URL of the API. Empty string = same origin (behind a reverse proxy).
# NEXT_PUBLIC_API_URL=http://localhost:8000
